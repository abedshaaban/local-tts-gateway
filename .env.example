APP_HOST=127.0.0.1
APP_PORT=47829

DEFAULT_LANG_CODE=a
DEFAULT_VOICE=af_heart
DEFAULT_SPEED=1.0
DEFAULT_TTS_MODEL=local-tts
DEFAULT_STT_MODEL=local-stt
ENABLED_MODELS=local-tts,local-stt
OUTPUT_DIR=outputs
SAVE_GENERATED_AUDIO=false
SAVE_TRANSCRIPTIONS=false

KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_MODEL_DIR=models/kokoro
KOKORO_LOCAL_ONLY=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=.cache/huggingface

# STT settings
STT_LANGUAGE=en
STT_ENGINE_ORDER=parakeet_mlx,whisper_cpp,faster_whisper
STT_RETURN_ENGINE_USED=true
WEBSOCKET_STT_MAX_BYTES=104857600
WEBSOCKET_STT_PARTIAL_INTERVAL_MS=1000
WEBSOCKET_STT_MIN_AUDIO_MS=500
WEBSOCKET_STT_VAD_THRESHOLD=0.015
WEBSOCKET_STT_VAD_SILENCE_MS=700
WEBSOCKET_STT_ROLLING_WINDOW_MS=15000
WEBSOCKET_TTS_MAX_BUFFER_CHARS=4000
WEBSOCKET_TTS_FLUSH_CHARS=240
CONVERSATION_BARGE_IN=true
CORS_ALLOW_ORIGIN_REGEX='^(https?://(localhost|127\.0\.0\.1)(:\d+)?|null)$'

# Parakeet MLX
PARAKEET_MLX_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# whisper.cpp fallback
WHISPER_CPP_BIN=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=./models/whisper/ggml-large-v3-turbo.bin

# faster-whisper fallback (openai/whisper-* aliases are supported)
FASTER_WHISPER_MODEL=openai/whisper-tiny.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
